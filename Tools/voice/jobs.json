[["hero_H001_atk", "68f20cc14cb81b9bf881021c", "불꽃처럼 타올라라!"], ["hero_H001_hit", "68f20cc14cb81b9bf881021c", "크윽... 아직이야!"], ["hero_H001_skill", "68f20cc14cb81b9bf881021c", "홍염의 스트라이커, 간다!"], ["hero_H002_atk", "68f20cc14cb81b9bf88101a6", "파도여, 휩쓸어라."], ["hero_H002_hit", "68f20cc14cb81b9bf88101a6", "아앗... 괜찮아요."], ["hero_H002_skill", "68f20cc14cb81b9bf88101a6", "심해의 무녀여, 치유의 물결을!"], ["hero_H003_atk", "68f20cc14cb81b9bf881014f", "흐읍! 받아라!"], ["hero_H003_hit", "68f20cc14cb81b9bf881014f", "끄떡없다!"], ["hero_H003_skill", "68f20cc14cb81b9bf881014f", "대지의 방패, 모두를 지켜라!"], ["hero_H004_atk", "68f20cc14cb81b9bf881014c", "그림자에 삼켜져라."], ["hero_H004_hit", "68f20cc14cb81b9bf881014c", "...제법이군."], ["hero_H004_skill", "68f20cc14cb81b9bf881014c", "그림자 군주의 이름으로."], ["hero_H005_atk", "68f20cc14cb81b9bf8810136", "빛이여, 길을 밝혀 주세요!"], ["hero_H005_hit", "68f20cc14cb81b9bf8810136", "꺄앗...!"], ["hero_H005_skill", "68f20cc14cb81b9bf8810136", "빛의 성녀여, 잠든 이들을 깨워라."], ["hero_H006_atk", "68f20cc14cb81b9bf881015d", "일곱 빛으로, 끝낸다!"], ["hero_H006_hit", "68f20cc14cb81b9bf881015d", "윽... 이 정도로는!"], ["hero_H006_skill", "68f20cc14cb81b9bf881015d", "세븐 스트라이커, 해방!"], ["hero_H007_atk", "68f20cc14cb81b9bf8810209", "재가 되어라!"], ["hero_H007_hit", "68f20cc14cb81b9bf8810209", "흥, 뜨겁지도 않아."], ["hero_H007_skill", "68f20cc14cb81b9bf8810209", "업화여, 모든 걸 불살라라!"], ["hero_H008_atk", "68f20cc14cb81b9bf8810147", "물살을 가른다!"], ["hero_H008_hit", "68f20cc14cb81b9bf8810147", "흐읏... 막아냈어."], ["hero_H008_skill", "68f20cc14cb81b9bf8810147", "해류 방벽, 전개!"], ["hero_H009_atk", "68f20cc14cb81b9bf881021e", "바람을 타고, 명중!"], ["hero_H009_hit", "68f20cc14cb81b9bf881021e", "아얏! 빗나가라니까!"], ["hero_H009_skill", "68f20cc14cb81b9bf881021e", "질풍의 화살, 한 발 더!"], ["hero_H010_atk", "68f20cc14cb81b9bf8810179", "폭풍처럼 베어 주마!"], ["hero_H010_hit", "68f20cc14cb81b9bf8810179", "칫... 얕았어."], ["hero_H010_skill", "68f20cc14cb81b9bf8810179", "폭풍의 검, 길을 열어라!"], ["hero_H011_atk", "68f20cc14cb81b9bf881021a", "뇌신의 주먹이다!"], ["hero_H011_hit", "68f20cc14cb81b9bf881021a", "크억! 짜릿한데!"], ["hero_H011_skill", "68f20cc14cb81b9bf881021a", "번개야, 부숴 버려라!"], ["hero_H012_atk", "68f20cc14cb81b9bf881012a", "번쩍! 맞았지?"], ["hero_H012_hit", "68f20cc14cb81b9bf881012a", "꺅! 따끔하잖아!"], ["hero_H012_skill", "68f20cc14cb81b9bf881012a", "연쇄 전격, 이어진다!"], ["hero_H013_atk", "68f20cc14cb81b9bf8810148", "으랴아!"], ["hero_H013_hit", "68f20cc14cb81b9bf8810148", "...간지럽군."], ["hero_H013_skill", "68f20cc14cb81b9bf8810148", "암반이여, 나를 따르라."], ["hero_H014_atk", "68f20cc14cb81b9bf8810133", "성광의 검을 받아라!"], ["hero_H014_hit", "68f20cc14cb81b9bf8810133", "흐읏... 무릎 꿇지 않아!"], ["hero_H014_skill", "68f20cc14cb81b9bf8810133", "성광의 기사여, 모두에게 축복을!"], ["hero_H015_atk", "68f20cc14cb81b9bf8810139", "후후, 고통을 맛봐."], ["hero_H015_hit", "68f20cc14cb81b9bf8810139", "감히... 나를?"], ["hero_H015_skill", "68f20cc14cb81b9bf8810139", "저주여, 영원히 스며들어라."], ["hero_H016_atk", "68f20cc14cb81b9bf881020c", "종언이다."], ["hero_H016_hit", "68f20cc14cb81b9bf881020c", "...무의미한 발버둥."], ["hero_H016_skill", "68f20cc14cb81b9bf881020c", "칠색의 종언, 사라져라."], ["hero_H017_atk", "68f20cc14cb81b9bf881015c", "간다, 스트라이커즈!"], ["hero_H017_hit", "68f20cc14cb81b9bf881015c", "크윽... 아직 안 끝났어!"], ["hero_H017_skill", "68f20cc14cb81b9bf881015c", "척력 반사! 튕겨 내라!"], ["hero_H018_atk", "68f20cc14cb81b9bf881018b", "물방울아, 힘을 빌려 줘!"], ["hero_H018_hit", "68f20cc14cb81b9bf881018b", "아... 아파라."], ["hero_H018_skill", "68f20cc14cb81b9bf881018b", "치유의 물방울, 모두에게!"], ["hero_H019_atk", "68f20cc14cb81b9bf88101e6", "폭풍의 눈을 보아라!"], ["hero_H019_hit", "68f20cc14cb81b9bf88101e6", "흐음... 아직 멀었다."], ["hero_H019_skill", "68f20cc14cb81b9bf88101e6", "폭풍의 눈, 휘몰아쳐라!"], ["hero_H020_atk", "68f20cc14cb81b9bf88101fe", "얼어붙어라."], ["hero_H020_hit", "68f20cc14cb81b9bf88101fe", "...무례하군요."], ["hero_H020_skill", "68f20cc14cb81b9bf88101fe", "호수의 여왕이 명한다."], ["hero_H021_atk", "68f20cc14cb81b9bf881015b", "도끼맛 좀 봐라!"], ["hero_H021_hit", "68f20cc14cb81b9bf881015b", "하! 그게 다냐?"], ["hero_H021_skill", "68f20cc14cb81b9bf881015b", "대지의 맹세, 꺾이지 않는다!"], ["hero_H022_atk", "68f20cc14cb81b9bf881014e", "이 노래를 받아라!"], ["hero_H022_hit", "68f20cc14cb81b9bf881014e", "아이쿠, 음정이 나갔네."], ["hero_H022_skill", "68f20cc14cb81b9bf881014e", "자유의 노래, 울려 퍼져라!"], ["hero_H023_atk", "68f20cc14cb81b9bf88101f7", "성광이여, 내려라!"], ["hero_H023_hit", "68f20cc14cb81b9bf88101f7", "흐윽... 빛은 꺼지지 않아요."], ["hero_H023_skill", "68f20cc14cb81b9bf88101f7", "성광의 축복을 그대들에게."], ["hero_H024_atk", "68f20cc14cb81b9bf881020e", "심연으로 떨어져라."], ["hero_H024_hit", "68f20cc14cb81b9bf881020e", "크크... 그 정도인가."], ["hero_H024_skill", "68f20cc14cb81b9bf881020e", "심연의 손아귀, 붙잡아라!"], ["hero_H025_atk", "68f20cc14cb81b9bf8810144", "잿빛으로 물들어라..."], ["hero_H025_hit", "68f20cc14cb81b9bf8810144", "...아프지 않다."], ["hero_H025_skill", "68f20cc14cb81b9bf8810144", "회색 잠식, 퍼져라."], ["hero_H026_atk", "68f20cc14cb81b9bf881015e", "빛이 너를 가르리라."], ["hero_H026_hit", "68f20cc14cb81b9bf881015e", "아... 별이 흔들려."], ["hero_H026_skill", "68f20cc14cb81b9bf881015e", "창세의 빛이여, 피어나라!"], ["hero_H027_atk", "68f20cc14cb81b9bf881015c", "일곱 빛깔로 간다!"], ["hero_H027_hit", "68f20cc14cb81b9bf881015c", "크윽... 이 빛은 꺼지지 않아!"], ["hero_H027_skill", "68f20cc14cb81b9bf881015c", "일곱 빛깔의 검, 해방!"], ["npc_rosie_628f0d18", "68f20cc14cb81b9bf8810129", "어서 와! 로지의 카드 상점에 온 걸 환영해~"], ["npc_rosie_d3823985", "68f20cc14cb81b9bf8810129", "오늘의 특가 카드 봤어? 하루에 한 번씩 바뀌니까 놓치지 마!"], ["npc_rosie_461cb62e", "68f20cc14cb81b9bf8810129", "새 부스터팩이 들어왔어! 좋은 카드가 나오길 같이 빌어 줄게~"], ["npc_rosie_0a07469c", "68f20cc14cb81b9bf8810129", "가공 카드를 원하면 가운데 방 엄마 아빠한테 가 봐! 마력부여사거든~"], ["npc_rosie_2288d39f", "68f20cc14cb81b9bf8810129", "슬리브랑 주사위는 뒤편 할아버지 공방에서 팔아. 루콘 할아버지 안경은... 놀라지 마!"], ["npc_rosie_bd7e387f", "68f20cc14cb81b9bf8810129", "왔구나! 오늘은 어떤 카드를 찾고 있어?"], ["npc_rosie_318dc053", "68f20cc14cb81b9bf8810129", "간지러~"], ["npc_rosie_c4662bf2", "68f20cc14cb81b9bf8810129", "이 마법사 모자 어때? 직접 고른 거야!"], ["npc_rosie_8dcbf6ff", "68f20cc14cb81b9bf8810129", "카드는 언제나 정성껏 관리하고 있어. 걱정 마!"], ["npc_rosie_084b3619", "68f20cc14cb81b9bf8810129", "특가 카드는 씨피 로 살 수 있어. 생성 비용의 딱 절반이야!"], ["npc_rosie_55a6c677", "68f20cc14cb81b9bf8810129", "남는 카드 칠십칠 장을 모아 가면 아빠가 더 좋은 카드로 바꿔 줘!"], ["npc_rosie_001c3c51", "68f20cc14cb81b9bf8810129", "할아버지 눈? 나도 딱 한 번 봤어. 그건 비밀이야~"], ["npc_lukon_05d63f2a", "68f20cc14cb81b9bf8810211", "어서 오게! 오늘은 무얼 꾸며 볼 텐가?"], ["npc_lukon_efa5170f", "68f20cc14cb81b9bf8810211", "또 왔구먼. 새로 깎은 주사위 좀 보고 가게나."], ["npc_lukon_2f194aa9", "68f20cc14cb81b9bf8810211", "속성마다 하나씩, 이 늙은이가 정성껏 만들었다네."], ["npc_lukon_bc6c9957", "68f20cc14cb81b9bf8810211", "로지 녀석은 장사 잘 하고 있던가?"], ["npc_lukon_09e975f6", "68f20cc14cb81b9bf8810211", "카드에도 옷이 필요하지. 슬리브 구경하고 가게!"], ["npc_lukon_7c85f8d7", "68f20cc14cb81b9bf8810211", "어이쿠, 안경 건드리지 말게! 이게 없으면 아무것도 안 보여!"], ["npc_lukon_b50bfe4b", "68f20cc14cb81b9bf8810211", "늙은이 수염은 왜 당기누."], ["npc_lukon_8f6a28e9", "68f20cc14cb81b9bf8810211", "이 주사위는 한 면 한 면 손으로 다듬었다네."], ["npc_lukon_96c3207d", "68f20cc14cb81b9bf8810211", "슬리브를 바꾸면 카드가 기분이 좋아진다네. 진짜야."], ["npc_lukon_632b178b", "68f20cc14cb81b9bf8810211", "눈? 이 안경 뒤에 있지. 본 사람은... 로지뿐일세."], ["npc_lukon_3a88d307", "68f20cc14cb81b9bf8810211", "덱케이스엔 레이드 보스들 문양을 새겼지. 진짜 보스는 못 봤지만!"], ["npc_rohan_32653d31", "68f20cc14cb81b9bf8810146", "이 팔뚝 보이지? 마력부여도 힘이 필요하다고!"], ["npc_rohan_008c7d7b", "68f20cc14cb81b9bf8810146", "아버지는 아직도 그 골뱅이 안경을 안 바꾸셨나?"], ["npc_rohan_d9ece7cd", "68f20cc14cb81b9bf8810146", "칠십칠 장! 행운의 숫자지. 칠이 두 개니까!"], ["npc_rohan_bb394bf5", "68f20cc14cb81b9bf8810146", "로지 녀석, 손님한테 친절하게 굴고 있겠지?"], ["npc_bella_cae1d498", "68f20cc14cb81b9bf881021f", "간지러워."], ["npc_bella_19ee8b4a", "68f20cc14cb81b9bf881021f", "로지가 장사 잘 하고 있니? 가끔 걱정이 돼서."], ["npc_bella_c41985e8", "68f20cc14cb81b9bf881021f", "유니크 카드는 레어 카드를 칠십칠 장 모아도 한 장밖에 안 나올 만큼 강력한 카드란다."], ["npc_bella_703caa21", "68f20cc14cb81b9bf881021f", "스트라이커즈 가공은 마력이 아주 많이 들어. 그래도 그만큼 반짝이지!"], ["npc_rohan_4042745d", "68f20cc14cb81b9bf8810146", "마음에 드는 가공이 됐길 바란다!"], ["npc_rohan_c2eed399", "68f20cc14cb81b9bf8810146", "어서 와라! 오늘은 어떤 카드에 마력을 불어넣어 볼까?"], ["npc_bella_8eff2184", "68f20cc14cb81b9bf881021f", "어서 오렴. 차 한잔하고 가도 좋단다."], ["npc_rohan_0d9c577e", "68f20cc14cb81b9bf8810146", "남는 카드가 칠십칠 장 모이면 가져와! 더 좋은 카드로 바꿔 주마."], ["npc_bella_8703558f", "68f20cc14cb81b9bf881021f", "가공은 섬세한 작업이라 씨피 가 꽤 들어. 신중하게 고르렴."], ["npc_bella_9278aa0e", "68f20cc14cb81b9bf881021f", "업그레이드로 나온 카드는 가공 없는 일반 카드란다. 잊지 마~"], ["npc_rohan_1c14e9e8", "68f20cc14cb81b9bf8810146", "오, 처음 보는 얼굴이구나! 나는 로한, 이쪽은 내 아내 벨라. 둘 다 마력부여사지!"], ["npc_bella_fe481374", "68f20cc14cb81b9bf881021f", "로지의 엄마 아빠란다. 카드 가공이랑 업그레이드는 우리한테 맡기렴."], ["npc_bella_d28e9cb3", "68f20cc14cb81b9bf881021f", "다 골랐니? 언제든 다시 오렴!"], ["npc_rosie_ff5c8ebb", "68f20cc14cb81b9bf8810129", "앗... 오팔이 조금 모자란 것 같아. 퀘스트를 깨고 다시 와 줘!"], ["npc_rosie_74083dcc", "68f20cc14cb81b9bf8810129", "열 팩이나?! 좋아, 레어 카드가 쏟아지길 기도할게!"], ["npc_rosie_2945a337", "68f20cc14cb81b9bf8810129", "두근두근... 좋은 카드가 나오길!"], ["npc_lukon_2ded1c22", "68f20cc14cb81b9bf8810211", "처음 보는 얼굴이로군! 나는 로지 할애비 루콘일세. 이 공방에선 슬리브, 덱케이스, 코인, 주사위를 직접 만든다네."], ["npc_lukon_edb61164", "68f20cc14cb81b9bf8810211", "눈이 안 보인다고? 걱정 말게, 이 안경 너머로 다 보인다네. ...아마도."], ["npc_lukon_a7fbc19e", "68f20cc14cb81b9bf8810211", "오팔이 조금 모자라구먼. 퀘스트를 깨고 다시 오게나."]]